# Smart Attendance backend settings
PORT=8000
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=10
# Pause between emails in milliseconds (helps avoid Gmail rate limits)
EMAIL_DELAY_MS=300
# Optional absolute path to Python. Leave blank to use python (Windows) / python3 (Linux/macOS).
PYTHON_BIN=

# SMTP EMAIL SETTINGS: fill these values for your email account.
# Gmail: use smtp.gmail.com, port 587, secure=false, and a Google App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender address, usually the same email address as SMTP_USER. Example: Your Name <you@gmail.com>
SMTP_FROM=

# Optional SMS via Twilio. Leave blank if you are only using email.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
